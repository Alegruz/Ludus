# Write INPUT's bytes into OUTPUT as a constexpr StaticArray named NAME.
# Test fixtures use it to carry a cooked `.lurgrt` into a browser build without a file system.
# Usage: cmake -DINPUT=<file> -DOUTPUT=<header> -DNAME=<IDENTIFIER> -P embed_bytes.cmake
if(NOT INPUT OR NOT OUTPUT OR NOT NAME MATCHES "^[A-Z][A-Z0-9_]*$")
    message(FATAL_ERROR "embed_bytes.cmake requires INPUT, OUTPUT and an upper-case NAME")
endif()
file(READ "${INPUT}" content HEX)
string(LENGTH "${content}" digits)
math(EXPR count "${digits} / 2")
if(count EQUAL 0)
    message(FATAL_ERROR "embed_bytes.cmake: ${INPUT} is empty")
endif()
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${content}")
file(WRITE "${OUTPUT}.tmp"
    "#pragma once\n"
    "#include <ludus/foundation/base/types.h>\n\n"
    "#include <ludus/foundation/containers/static_array.hpp>\n\n"
    "/// Bytes of ${INPUT}, generated by embed_bytes.cmake.\n"
    "inline constexpr ludus::foundation::usize ${NAME}_BYTE_COUNT = ${count};\n"
    "inline constexpr ludus::foundation::StaticArray<ludus::foundation::uint8, ${NAME}_BYTE_COUNT> ${NAME}{{${bytes}}};\n")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
