# Ludus coding standards enforcement. See AGENTS.md for the full rules.
#
# C++ exceptions are banned project-wide. This is enforced primarily by the
# compiler: engine code builds with -fno-exceptions (cmake/EngineOptions.cmake),
# so any throw / try / catch in engine code is a hard compile error. The
# hicpp-exception-baseclass check below is an additional guard. Do not add
# exception-based error handling; use status codes / std::optional / return
# values instead.
#
# readability-simplify-boolean-expr is deliberately off: the house style
# (AGENTS.md "Naming") writes `condition == false` and `condition == true`,
# which that check reports as redundant literals.
#
# Identifier naming is enforced per directory: modules that have adopted the
# AGENTS.md naming rules carry their own .clang-tidy with
# InheritParentConfig: true and readability-identifier-naming. See
# config/naming_scopes.txt and tools/check_naming.py for the text-level rules.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-chained-comparison,
  performance-*,
  portability-*,
  hicpp-exception-baseclass,
  modernize-avoid-bind,
  modernize-use-default-member-init,
  modernize-use-nodiscard,
  modernize-use-nullptr,
  modernize-use-override,
  readability-avoid-const-params-in-decls,
  readability-braces-around-statements,
  readability-container-size-empty,
  readability-duplicate-include,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-redundant-member-init
WarningsAsErrors: ''
HeaderFilterRegex: '(.*/)?(modules|apps|tools|tests|examples)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '1'
