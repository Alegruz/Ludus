{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "environment": {
        "CONAN_HOME": "${sourceDir}/out/conan/home",
        "CONAN_NON_INTERACTIVE": "1",
        "PATH": "${sourceDir}/out/host-tools/bin:${sourceDir}/out/host-tools/venv/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "${sourceDir}/out/host-tools/bin/clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/out/host-tools/venv/bin/ninja",
        "LUDUS_BUILD_SMOKE_APP": "ON",
        "LUDUS_ENABLE_CCACHE": "OFF",
        "LUDUS_ENABLE_COVERAGE": "OFF",
        "LUDUS_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/linux-clang-debug/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF"
      }
    },
    {
      "name": "linux-clang-development",
      "displayName": "Linux Clang Development",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/linux-clang-development/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF"
      }
    },
    {
      "name": "linux-clang-asan-ubsan",
      "displayName": "Linux Clang ASan UBSan",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/linux-clang-asan-ubsan/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON",
        "LUDUS_ENABLE_ASAN": "ON",
        "LUDUS_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/linux-clang-release/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "OFF",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "environment": {
        "CONAN_HOME": "${sourceDir}/out/conan/home",
        "CONAN_NON_INTERACTIVE": "1",
        "PATH": "${sourceDir}/out/host-tools/venv/Scripts;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/out/host-tools/venv/Scripts/ninja.exe",
        "LUDUS_BUILD_SMOKE_APP": "ON",
        "LUDUS_ENABLE_CCACHE": "OFF",
        "LUDUS_ENABLE_COVERAGE": "OFF",
        "LUDUS_ENABLE_ASAN": "OFF",
        "LUDUS_ENABLE_UBSAN": "OFF",
        "LUDUS_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/windows-msvc-debug/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc-development",
      "displayName": "Windows MSVC Development",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/windows-msvc-development/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/windows-msvc-release/conan_toolchain.cmake",
        "LUDUS_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "linux-clang-development",
      "configurePreset": "linux-clang-development"
    },
    {
      "name": "linux-clang-asan-ubsan",
      "configurePreset": "linux-clang-asan-ubsan"
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-development",
      "configurePreset": "windows-msvc-development"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-development",
      "configurePreset": "linux-clang-development",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-asan-ubsan",
      "configurePreset": "linux-clang-asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc-development",
      "configurePreset": "windows-msvc-development",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
