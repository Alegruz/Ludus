{
    "version": 8,
    "configurePresets": [
        {
            "name": "ninja_clang",
            "hidden": true,
            "displayName": "Ninja with Clang",
            "description": "Using Ninja generator with Clang compiler and ccache",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
            }
        },
        {
            "name": "ninja_clang-debug",
            "displayName": "Ninja with Clang - Debug",
            "inherits": "ninja_clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ninja_clang-release",
            "displayName": "Ninja with Clang - Release",
            "inherits": "ninja_clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ninja_gcc",
            "hidden": true,
            "displayName": "Ninja with GCC",
            "description": "Using Ninja generator with GCC compiler and ccache",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
            }
        },
        {
            "name": "ninja_gcc-debug",
            "displayName": "Ninja with GCC - Debug",
            "inherits": "ninja_gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ninja_gcc-release",
            "displayName": "Ninja with GCC - Release",
            "inherits": "ninja_gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ninja_msvc",
            "hidden": true,
            "displayName": "Ninja with MSVC",
            "description": "Using Ninja generator with MSVC compiler",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_C_COMPILER_LAUNCHER": "",
                "CMAKE_CXX_COMPILER_LAUNCHER": ""
            }
        },
        {
            "name": "ninja_msvc-debug",
            "displayName": "Ninja with MSVC - Debug",
            "inherits": "ninja_msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ninja_msvc-release",
            "displayName": "Ninja with MSVC - Release",
            "inherits": "ninja_msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ninja_clang-debug",
            "displayName": "Ninja with Clang - Debug",
            "configurePreset": "ninja_clang-debug",
            "configuration": "Debug",
            "jobs": 0
        },
        {
            "name": "ninja_clang-release",
            "displayName": "Ninja with Clang - Release",
            "configurePreset": "ninja_clang-release",
            "configuration": "Release",
            "jobs": 0
        },
        {
            "name": "ninja_gcc-debug",
            "displayName": "Ninja with GCC - Debug",
            "configurePreset": "ninja_gcc-debug",
            "configuration": "Debug",
            "jobs": 0
        },
        {
            "name": "ninja_gcc-release",
            "displayName": "Ninja with GCC - Release",
            "configurePreset": "ninja_gcc-release",
            "configuration": "Release",
            "jobs": 0
        },
        {
            "name": "ninja_msvc-debug",
            "displayName": "Ninja with MSVC - Debug",
            "configurePreset": "ninja_msvc-debug",
            "configuration": "Debug",
            "jobs": 0
        },
        {
            "name": "ninja_msvc-release",
            "displayName": "Ninja with MSVC - Release",
            "configurePreset": "ninja_msvc-release",
            "configuration": "Release",
            "jobs": 0
        }
    ]
}