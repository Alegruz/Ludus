#!/usr/bin/env python3
"""Check the built wiki's links/assets and search destinations before publishing.

MkDocs checks Markdown inputs; this complementary pass checks rendered output
at the configured project-site base path. Third-party sites are not crawled.
"""
from __future__ import annotations

import argparse
from html.parser import HTMLParser
import json
from pathlib import Path
import sys
from urllib.parse import unquote, urljoin, urlsplit

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parent / "python"))
from documentation import digest, sources

# Application documents still undergo link/asset validation. Keep this inventory
# explicit so unrelated HTML cannot bypass the authored-page search gate, and
# standalone documentation checks do not depend on browser build tools.
APPLICATION_PAGES = {
    "editor/index.html",
    "editor/players/cornell-box/index.html",
    "editor/players/live-edit-game/index.html",
    "editor/players/scripted-game/index.html",
}


def check_sources(root, site):
    """Require exact source coverage and reject stale or altered build outputs."""
    root, site = root.resolve(), site.resolve()
    failures = []
    try:
        manifest = json.loads((site / "documentation-sources.json").read_text(encoding="utf-8"))
        if manifest["version"] != 1 or not isinstance(manifest["pages"], list):
            return ["Invalid documentation source manifest"]
        expected = {path.relative_to(root).as_posix() for path in sources(root)}
        seen = set()
        outputs = set()
        assets = manifest.get("assets", [])
        if not isinstance(assets, list):
            return ["Invalid documentation asset manifest"]
        asset_sources = {entry["source"] for entry in assets}
        for entry in manifest["pages"] + assets:
            source, output = entry["source"], entry["output"]
            if not isinstance(source, str) or not isinstance(output, str):
                failures.append("Invalid documentation source/output path")
                continue
            if source in seen or output in outputs:
                failures.append(f"Duplicate documentation source/output: {source}")
            seen.add(source)
            outputs.add(output)
            source_path, output_path = root / source, site / output
            is_asset = source in asset_sources
            if ((source not in expected and not is_asset)
                    or (is_asset and source_path.suffix == ".md")
                    or not source_path.resolve().is_relative_to(root / "docs")
                    or not output_path.resolve().is_relative_to(site)
                    or (not is_asset and not output.endswith(".html"))):
                failures.append(f"Invalid documentation source/output mapping: {source}")
                continue
            if not source_path.is_file() or digest(source_path) != entry["source_sha256"]:
                failures.append(f"Stale documentation source: {source}; rebuild the wiki")
            if not output_path.is_file() or digest(output_path) != entry["output_sha256"]:
                failures.append(f"Missing or altered documentation output: {output}")
        for missing in sorted(expected - seen):
            failures.append(f"Documentation absent from wiki: {missing}")
    except (OSError, ValueError, KeyError, TypeError) as error:
        failures.append(f"Invalid or missing documentation source manifest: {error}")
    return failures


class Page(HTMLParser):
    def __init__(self, text):
        super().__init__(convert_charrefs=True)
        self.anchors = set()
        self.links = []
        self.feed(text)

    def handle_starttag(self, tag, attrs):
        for key, value in attrs:
            if value is None:
                continue
            if key == "id" or (tag == "a" and key == "name"):
                self.anchors.add(value)
            if key == "href" or (key == "src" and tag in {"img", "script", "iframe", "source"}):
                self.links.append(value)


def check(root, site, config, documentation_only=False):
    base = config["site_url"].rstrip("/") + "/"
    base_parts = urlsplit(base)
    repo_parts = urlsplit(config["repo_url"].rstrip("/"))
    source_failures = check_sources(root, site) if config.get("docs_dir") == "docs" else []
    failures = list(source_failures)
    if not (site / "index.html").is_file():
        return ["Missing built index.html; run mkdocs build --strict first"]
    for path in site.rglob("*"):
        if path.is_symlink():
            failures.append(f"Symlink in site artifact: {path.relative_to(site)}")
    pages = {
        path.relative_to(site).as_posix(): Page(path.read_text(encoding="utf-8"))
        for path in site.rglob("*.html") if not path.is_symlink()
        and not (documentation_only and path.relative_to(site).as_posix() in APPLICATION_PAGES)
    }

    def destination(value, origin):
        if not value or value.startswith(("mailto:", "tel:", "data:")):
            return
        parts = urlsplit(urljoin(base + origin, value))
        if parts.netloc == repo_parts.netloc and parts.path.startswith(repo_parts.path + "/"):
            remainder = parts.path[len(repo_parts.path) + 1:].split("/", 2)
            if len(remainder) == 3 and remainder[0] in {"blob", "tree", "edit"} and remainder[1] == "main":
                source = root / unquote(remainder[2])
                if not source.resolve().is_relative_to(root) or not source.exists():
                    failures.append(f"{origin}: missing repository source {value}")
            return
        if parts.netloc != base_parts.netloc:
            return
        decoded = unquote(parts.path)
        if not decoded.startswith(base_parts.path):
            failures.append(f"{origin}: link escapes project-site base path: {value}")
            return
        relative = decoded[len(base_parts.path):]
        target = site / relative
        if not target.resolve().is_relative_to(site):
            failures.append(f"{origin}: link escapes site artifact: {value}")
            return
        if target.is_dir():
            target = target / "index.html"
        if not target.is_file():
            failures.append(f"{origin}: missing local destination {value}")
            return
        fragment = unquote(parts.fragment)
        target_page = pages.get(target.relative_to(site).as_posix())
        if fragment and target_page is not None and fragment not in target_page.anchors:
            failures.append(f"{origin}: missing anchor {value}")
        return target.relative_to(site).as_posix()

    for path, page in pages.items():
        destinations = {destination(value, path) for value in page.links}
        if path.startswith("api/"):
            for target in ("index.html", "reference/index.html"):
                if target not in destinations:
                    failures.append(f"{path}: missing API return link to {target}")
        elif path == "reference/index.html" and "api/index.html" not in destinations:
            failures.append(f"{path}: missing link to generated API reference")
    try:
        search = json.loads((site / "search/search_index.json").read_text(encoding="utf-8"))
        documents = search["docs"]
        if not isinstance(documents, list) or not documents:
            failures.append("Empty or invalid search index")
        else:
            indexed = set()
            for document in documents:
                location = document["location"]
                if not isinstance(location, str):
                    failures.append("Invalid search destination")
                    continue
                # MkDocs represents the site's home page with an empty URL.
                target = destination(location or ".", "index.html")
                if target is not None:
                    indexed.add(target)
            static_pages = set()
            if config.get("docs_dir") == "docs" and not source_failures:
                manifest = json.loads((site / "documentation-sources.json").read_text(encoding="utf-8"))
                static_pages = {entry["output"] for entry in manifest.get("assets", [])
                                if entry["source"].endswith(".html")}
            for missing in sorted(set(pages) - {"404.html"} - APPLICATION_PAGES - static_pages - indexed):
                failures.append(f"Page missing from search index: {missing}")
    except (OSError, ValueError, KeyError, TypeError) as error:
        failures.append(f"Invalid search index: {error}")
    return failures


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--documentation-only", action="store_true",
                        help="Check documentation without the separate browser editor payload")
    args = parser.parse_args()
    root = args.root.resolve()
    try:
        config = yaml.safe_load((root / "mkdocs.yml").read_text(encoding="utf-8"))
        failures = check(root, (root / config["site_dir"]).resolve(), config, args.documentation_only)
    except (OSError, ValueError, KeyError, TypeError, yaml.YAMLError) as error:
        failures = [str(error)]
    if failures:
        for failure in failures:
            print(f"Wiki check: {failure}", file=sys.stderr)
        return 1
    print("Wiki source parity, artifact, local links/assets, source references and search destinations passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
