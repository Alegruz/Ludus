#!/usr/bin/env python3
"""Explicit acquisition/build of the SDK's pinned offline GLSL ES translator."""
import hashlib
import json
import os
import platform
from pathlib import Path
import subprocess
import sys
import tarfile
import urllib.request

def digest(path): return hashlib.sha256(path.read_bytes()).hexdigest()


def cached_translator(destination: Path, pin: dict, compiler: str) -> bool:
    binary = destination / 'bin/spirv-cross'
    if not binary.is_file() or not (destination / 'LICENSE').is_file():
        return False
    try:
        manifest = json.loads(Path(str(binary) + '.build.json').read_text())
        return (isinstance(manifest, dict)
                and all(manifest.get(key) == pin[key] for key in ('tag', 'commit', 'source_sha256'))
                and manifest.get('compiler') == compiler
                and manifest.get('binary_sha256') == digest(binary))
    except (OSError, ValueError):
        return False


def main() -> None:
    ROOT = Path(__file__).resolve().parent.parent
    pin = json.loads((ROOT / 'config/spirv_cross_toolchain.json').read_text())['spirv_cross']
    if (platform.system(), platform.machine()) not in {('Linux','x86_64'), ('Darwin','arm64'), ('Darwin','x86_64')}:
        raise SystemExit('Pinned bootstrap supports Linux x86_64 and native macOS')
    tools = ROOT / 'out/shader-tools'
    destination = tools / 'spirv-cross'
    sys.path.insert(0, str(ROOT / 'scripts/python'))
    from engine import pinned_llvm_major
    llvm_major = pinned_llvm_major(ROOT)
    cxx = str(ROOT / 'out/host-tools/bin/clang++') if platform.system() == 'Darwin' else f'clang++-{llvm_major}'
    cc = str(ROOT / 'out/host-tools/bin/clang') if platform.system() == 'Darwin' else f'clang-{llvm_major}'
    compiler = subprocess.check_output([cxx, '--version'], text=True).splitlines()[0]
    if f'clang version {llvm_major}.' not in compiler:
        raise SystemExit(f'SPIRV-Cross bootstrap requires pinned Clang {llvm_major}')
    archive = tools / 'spirv-cross-src/spirv-cross.tar.gz'
    archive.parent.mkdir(parents=True, exist_ok=True)
    if not archive.exists() or digest(archive) != pin['source_sha256']:
        temporary = archive.with_suffix('.download')
        urllib.request.urlretrieve(pin['source_url'], temporary)
        if digest(temporary) != pin['source_sha256']:
            raise SystemExit('SPIRV-Cross source archive integrity failure')
        temporary.replace(archive)
    if cached_translator(destination, pin, compiler):
        print(destination / 'bin/spirv-cross')
        return
    source = archive.parent / 'source'
    source.mkdir(exist_ok=True)
    with tarfile.open(archive) as contents:
        if hasattr(tarfile, 'data_filter'):
            contents.extractall(source, filter='data')
        else:
            # Python 3.10 lacks extraction filters; pinned archives still must not
            # escape their extraction root or introduce special files/symlinks.
            for member in contents.getmembers():
                parts = Path(member.name).parts
                if Path(member.name).is_absolute() or '..' in parts or not (member.isfile() or member.isdir()):
                    raise SystemExit('Unsafe SPIRV-Cross source member')
            contents.extractall(source)
    roots = [p for p in source.iterdir() if p.is_dir()]
    if len(roots) != 1: raise SystemExit('Unexpected source archive layout')
    cmake = ROOT / 'out/host-tools/venv/bin/cmake'
    build = tools / 'spirv-cross-build'
    native_args = []
    if platform.system() == 'Darwin':
        native_args = ['-DCMAKE_OSX_SYSROOT=' + str(ROOT / 'out/host-tools/macos-sdk'),
                       '-DCMAKE_CXX_FLAGS=-nostdinc++ -isystem "' + str(ROOT / 'out/host-tools/libcxx-include') + '" -stdlib=libc++']
    subprocess.run([str(cmake), '-S', str(roots[0]), '-B', str(build), '-G', 'Ninja',
        '-DCMAKE_MAKE_PROGRAM=' + str(ROOT/'out/host-tools/venv/bin/ninja'),
        '-DCMAKE_CXX_COMPILER=' + cxx, '-DCMAKE_C_COMPILER=' + cc,
        '-DCMAKE_BUILD_TYPE=Release', '-DCMAKE_INSTALL_PREFIX=' + str(destination),
        '-DSPIRV_CROSS_ENABLE_TESTS=OFF', '-DSPIRV_CROSS_ENABLE_HLSL=ON',
        '-DSPIRV_CROSS_ENABLE_MSL=ON', '-DSPIRV_CROSS_ENABLE_CPP=ON'] + native_args, check=True)
    subprocess.run([str(cmake), '--build', str(build), '-j', os.environ.get('CMAKE_BUILD_PARALLEL_LEVEL', '4')], check=True)
    subprocess.run([str(cmake), '--install', str(build)], check=True)
    (destination / 'LICENSE').write_bytes((roots[0]/'LICENSE').read_bytes())
    binary = (destination / 'bin/spirv-cross').resolve()
    manifest = {key:pin[key] for key in ('tag', 'commit', 'source_sha256')}
    manifest['binary_sha256'] = digest(binary)
    manifest['compiler'] = compiler
    Path(str(binary) + '.build.json').write_text(json.dumps(manifest, indent=2)+'\n')
    print(binary)


if __name__ == '__main__':
    main()
