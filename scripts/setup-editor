#!/usr/bin/env bash
set -euo pipefail
script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
python_command="$script_dir/../out/host-tools/venv/bin/python"
if [[ ! -x "$python_command" ]]; then python_command=python3; fi
exec "$python_command" "${script_dir}/python/editor_setup.py" select "$@"
