#!/usr/bin/env python3
"""Run paired R5 native image checks and export CPU distributions, never GPU time."""
import argparse
import csv
import io
import json
import os
from pathlib import Path
import platform
import subprocess
import hashlib


def percentile(values, fraction):
    ordered = sorted(values)
    return ordered[min(len(ordered) - 1, int((len(ordered) - 1) * fraction))]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--executable", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--backend", choices=("metal", "vulkan"), required=True)
    parser.add_argument("--device", required=True, help="Actual device/driver identity from this host")
    parser.add_argument("--runs", type=int, default=3)
    args = parser.parse_args()
    if not 1 <= args.runs <= 10:
        parser.error("--runs must be 1..10")
    args.output.mkdir(parents=True, exist_ok=True)
    results = []
    for run in range(args.runs):
        process = subprocess.run(
            [str(args.executable.resolve()), "Portable indexed*", "--section",
             "R5 merged painter order matches unmerged complete image"],
            env={**os.environ, "LUDUS_RHI_BENCHMARK": "1"}, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)
        (args.output / f"run-{run}.log").write_text(process.stdout)
        if process.returncode:
            raise SystemExit(f"Image/benchmark failure: {args.output / f'run-{run}.log'}")
        expected_backend = "R5BACKEND," + ("3" if args.backend == "metal" else "0")
        if expected_backend not in process.stdout.splitlines():
            raise SystemExit("Benchmark binary backend differs from --backend")
        rows = list(csv.reader(io.StringIO("\n".join(
            line for line in process.stdout.splitlines() if line.startswith("R5,")))))
        if len(rows) != 1024:
            raise SystemExit(f"Incomplete measurement: {len(rows)} of 1024 samples")
        for layers in (1, 8, 16, 31):
            for merge in (0, 1):
                selected = [list(map(int, row[1:])) for row in rows
                            if int(row[1]) == layers and int(row[3]) == merge]
                if len(selected) != 128 or sorted(row[1] for row in selected) != list(range(128)):
                    raise SystemExit("Invalid paired sample identities")
                result = {"run": run, "layers": layers, "merge": bool(merge), "samples": 128,
                          "raster_passes": selected[0][6], "draws": selected[0][7],
                          "plan_bytes": selected[0][8], "buffer_bytes": selected[0][9],
                          "texture_bytes": selected[0][10]}
                for name, column in (("setup_cpu_ns", 3), ("execute_cpu_ns", 4),
                                     ("readback_wait_cpu_ns", 5)):
                    values = [row[column] for row in selected]
                    result[name] = {"p50": percentile(values, .50),
                                    "p95": percentile(values, .95), "p99": percentile(values, .99)}
                results.append(result)
    revision = subprocess.run(["git", "rev-parse", "HEAD"], check=True, text=True,
                              stdout=subprocess.PIPE).stdout.strip()
    report = {"revision": revision, "backend": args.backend, "device": args.device,
              "working_tree_dirty": bool(subprocess.run(["git", "status", "--porcelain"], check=True, text=True, stdout=subprocess.PIPE).stdout),
              "executable_sha256": hashlib.sha256(args.executable.read_bytes()).hexdigest(),
              "host": platform.platform(), "warmup_pairs_per_workload": 16,
              "resolution": [96, 64], "ordering": "alternate merged/unmerged first each pair",
              "correctness": "Every complete RGBA image equals the unmerged oracle",
              "gpu_duration_ns": None, "input_to_display_ns": None,
              "driver_backing_bytes": None, "driver_allocations": None,
              "note": "CPU timers include authoring/compile or acquire/encode/submit; readback wait is neither GPU time nor presentation latency. Logical imported bytes exclude padding, staging, surface and pool slack.",
              "results": results}
    path = args.output / "report.json"
    path.write_text(json.dumps(report, indent=2) + "\n")
    print(f"Paired image checks and {args.runs * 1024} samples passed: {path}")


if __name__ == "__main__":
    main()
