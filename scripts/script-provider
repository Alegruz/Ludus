#!/usr/bin/env python3
"""Prepare, cook and validate the optional installed S4 provider."""
import argparse
import hashlib
import json
from pathlib import Path
import runpy
import sys
import shlex
import subprocess
ROOT=Path(__file__).resolve().parent.parent
S1=runpy.run_path(str(ROOT/'scripts/script-interaction'),run_name='s1_tool')
sys.path.insert(0,str(ROOT/'scripts/python'))
from ludus_tools import behavior_cook

def cook():
    S1['check_host']()
    work=ROOT/'out/script-provider'; work.mkdir(parents=True,exist_ok=True)
    profile={'version':1,**json.loads((ROOT/'out/script-interaction/host.json').read_text())}
    profile['profile']=profile.pop('pin')
    (work/'profile.json').write_text(json.dumps(profile)+'\n')
    fixture=ROOT/'tools/script-provider/fixtures'
    return behavior_cook.cook(fixture/'contract.json',fixture/'package.json',work/'cooked',work/'profile.json',S1['COMPILER'],S1['ANALYZER'])

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action',choices=['bootstrap','cook','verify','verify-tools','run','check'])
    parser.add_argument('--preset',default='linux-clang-development')
    parser.add_argument('--fix',action='store_true')
    args=parser.parse_args()
    if args.action=='bootstrap': S1['bootstrap']()
    elif args.action=='cook': print(cook())
    elif args.action=='verify-tools': S1['check_host']()
    elif args.action=='verify':
        S1['check_host']()
        work=ROOT/'out/script-provider/cooked'
        pointer=behavior_cook.read_json(work/'current.json')
        evidence=behavior_cook.read_json(work/pointer['key']/'evidence.json')
        fixture=ROOT/'tools/script-provider/fixtures'
        expected=behavior_cook.cook_key(behavior_cook.contract(fixture/'contract.json'),behavior_cook.package(fixture/'package.json'),behavior_cook.read_json(ROOT/'out/script-provider/profile.json'))
        behavior_cook.require(expected==pointer['key']==evidence['key'],'stale S4 cook; run script-provider cook')
        behavior_cook.require(evidence['outputs']=={p.name:behavior_cook.sha(p.read_bytes()) for p in (work/pointer['key']).iterdir() if p.name!='evidence.json'}, 'modified S4 cook')
    elif args.action=='run':
        cook()
        extra=['-DLUDUS_BUILD_BEHAVIOR=ON','-DLUDUS_BUILD_BEHAVIOR_ACCEPTANCE=ON','-DLUDUS_WARNINGS_AS_ERRORS=ON']
        if args.preset.startswith('web-'): extra += ['-DLUDUS_BUILD_SMOKE_APP=OFF','-DLUDUS_BUILD_WEB_PROBES=OFF']
        S1['run']([S1['host_tool']('cmake'),'--preset',args.preset,*extra])
        targets=['ludus_behavior_acceptance'] if args.preset.startswith('web-') else ['ludus_behavior_acceptance','ludus_behavior_tests']
        S1['run']([S1['host_tool']('cmake'),'--build','--preset',args.preset,'--target',*targets,'-j','2'])
        S1['run']([S1['host_tool']('ctest'),'--preset',args.preset,'-R','^ludus_behavior_','--output-on-failure','--no-tests=error'])
    else:
        S1['check'](args.preset,args.fix)
        from formatting import format_source
        paths=list((ROOT/'modules/runtime/behavior').rglob('*.cpp'))+list((ROOT/'modules/runtime/behavior').rglob('*.h'))+list((ROOT/'tools/script-provider').rglob('*.cpp'))
        for source in paths:
            code=source.read_text()
            formatted=format_source(code,source,'clang-format-18')
            if args.fix: source.write_text(formatted)
            else: S1['require'](code==formatted,f'Format {source} with script-provider check --fix')
        if args.fix: return
        entries=json.loads((ROOT/'out/build'/args.preset/'compile_commands.json').read_text())
        for entry in entries:
            if not any(part in entry['file'] for part in ('/modules/runtime/behavior/','/tools/script-provider/')): continue
            if args.preset.startswith('web-'):
                from web_build import analysis_commands
                commands=analysis_commands(ROOT,[entry],'clang-tidy-18',ROOT/'out/host-tools/emsdk/upstream/emscripten/cache/sysroot')
                S1['run']([flag for flag in commands[0] if flag!='-sSUPPORT_LONGJMP=wasm'])
            else:
                flags=shlex.split(entry['command'])[1:]; clean=[]; index=0
                while index<len(flags):
                    flag=flags[index]
                    if flag=='-o': index+=2; continue
                    if flag not in ('-c',entry['file']) and not flag.startswith('@'): clean.append(flag)
                    index+=1
                S1['run'](['clang-tidy-18',entry['file'],'--quiet','--warnings-as-errors=*','--',*clean])
if __name__=='__main__':
    try:main()
    except (OSError,ValueError,KeyError,TypeError,RecursionError,RuntimeError,subprocess.SubprocessError) as error:
        detail=error.stderr.decode(errors='replace')[-8192:] if isinstance(error,subprocess.CalledProcessError) and error.stderr else ''
        print('S4 provider failed: '+str(error)+'\n'+detail,file=sys.stderr)
        raise SystemExit(1)
