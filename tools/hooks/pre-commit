#!/usr/bin/env python3
"""
Pre-commit hook to validate dependency versions.
Install with: cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
"""

import re
import sys
from pathlib import Path

def check_cmake_versions():
    """Validate CMakeLists.txt version formats"""
    cmake_file = Path("CMakeLists.txt")
    if not cmake_file.exists():
        return True
    
    content = cmake_file.read_text()
    errors = []
    
    # Check VOLK_TAG
    volk_match = re.search(r'set\(VOLK_TAG\s+(\S+)\)', content)
    if volk_match:
        tag = volk_match.group(1)
        if not re.match(r'vulkan-sdk-\d+\.\d+\.\d+\.\d+', tag):
            errors.append(f"Invalid VOLK_TAG: {tag}")
            errors.append("  Expected: vulkan-sdk-X.Y.Z.W (e.g., vulkan-sdk-1.4.335.0)")
    
    # Check VULKAN_HEADERS_TAG
    headers_match = re.search(r'set\(VULKAN_HEADERS_TAG\s+(\S+)\)', content)
    if headers_match:
        tag = headers_match.group(1)
        if not re.match(r'v\d+\.\d+\.\d+', tag):
            errors.append(f"Invalid VULKAN_HEADERS_TAG: {tag}")
            errors.append("  Expected: vX.Y.Z (e.g., v1.3.275)")
    
    if errors:
        print("[FAIL] CMake version validation failed:")
        for error in errors:
            print(f"  {error}")
        return False
    
    print("[OK] CMake versions are valid")
    return True

def main():
    if not check_cmake_versions():
        sys.exit(1)
    sys.exit(0)

if __name__ == "__main__":
    main()
