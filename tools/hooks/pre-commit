#!/usr/bin/env python3
"""
Pre-commit hook to validate dependency versions.
Install with: cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
"""

import re
import sys
from pathlib import Path

def check_cmake_versions():
    """Validate CMakeLists.txt version formats"""
    cmake_file = Path("CMakeLists.txt")
    if not cmake_file.exists():
        return True
    
    content = cmake_file.read_text()
    errors = []
    
    def extract_tag(var_name: str):
        match = re.search(rf'set\({var_name}\s+([^\)]+)\)', content)
        if not match:
            return None
        # Support optional quoted values in CMake set(...)
        return match.group(1).strip().strip('"\'')

    # Check VOLK_TAG
    volk_tag = extract_tag("VOLK_TAG")
    if volk_tag:
        if not re.fullmatch(r'vulkan-sdk-\d+\.\d+\.\d+\.\d+', volk_tag):
            errors.append(f"Invalid VOLK_TAG: {volk_tag}")
            errors.append("  Expected: vulkan-sdk-X.Y.Z.W (e.g., vulkan-sdk-1.4.335.0)")
    
    # Check VULKAN_HEADERS_TAG
    headers_tag = extract_tag("VULKAN_HEADERS_TAG")
    if headers_tag:
        if not re.fullmatch(r'v\d+\.\d+\.\d+', headers_tag):
            errors.append(f"Invalid VULKAN_HEADERS_TAG: {headers_tag}")
            errors.append("  Expected: vX.Y.Z (e.g., v1.3.275)")
    
    if errors:
        print("[FAIL] CMake version validation failed:")
        for error in errors:
            print(f"  {error}")
        return False
    
    print("[OK] CMake versions are valid")
    return True

def main():
    if not check_cmake_versions():
        sys.exit(1)
    sys.exit(0)

if __name__ == "__main__":
    main()
