# Thanks to Dimitri van Heesch / Doxygen, "Configuration" and "Documenting the
# code": extract declarations and structured comments, retaining XML for coverage.
# https://www.doxygen.nl/manual/config.html
# https://www.doxygen.nl/manual/docblocks.html
# Input/output paths are appended by scripts/build-api; do not scan the checkout.
PROJECT_NAME           = "Ludus SDK"
PROJECT_BRIEF          = "Public C++ API reference"
USE_MDFILE_AS_MAINPAGE  = docs/api-main.md
GENERATE_HTML          = NO
GENERATE_XML           = YES
GENERATE_LATEX         = NO
XML_OUTPUT             = xml
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
EXCLUDE_SYMBOLS        = "*::detail::*" "*::internal::*"
INTERNAL_DOCS          = NO
FULL_PATH_NAMES        = NO
SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = NO
SHOW_INCLUDE_FILES     = NO
HAVE_DOT               = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
ENABLE_PREPROCESSING   = NO
EXTENSION_MAPPING      = in=C++
FILE_PATTERNS          = *.h *.hpp *.in *.md
