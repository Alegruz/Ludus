    "version": "0.2.0",
    "configurations": [
        {
            "type": "cppvsdbg",
            "request": "launch",
            "name": "Debug LudusEditor (x64-Debug)",
            "program": "${workspaceFolder}/LudusEditor.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "halt_on_error=1:abort_on_error=1:disable_coredump=0:unmap_shadow_on_exit=1:mmap_limit_mb=2048"
                }
            ]
        },
        {
            "type": "cppvsdbg",
            "request": "launch",
            "name": "Debug LudusEditor (x64-Release)",
            "program": "${workspaceFolder}/LudusEditor.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
        },
        {
            "type": "cppdbg",
            "request": "launch",
            "name": "Debug LudusEditor (UNIX)",
            "program": "${workspaceFolder}/LudusEditor",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "args": [
            ]
        },
